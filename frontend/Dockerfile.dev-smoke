FROM node:20-alpine
WORKDIR /app
# scripts/ lands before npm ci because postinstall runs copy-lottie-wasm.mjs;
# copying it alongside the manifests keeps the dependency layer cacheable.
COPY package.json package-lock.json ./
COPY scripts ./scripts
RUN npm ci
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
