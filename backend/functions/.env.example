# AzureOpenAI chat model
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=

# AzureOpenAI embedding model
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_ENDPOINT=
OPENAI_EMBEDDING_API_VERSION=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=

# Firebase Configuration
FB_TYPE=
FB_PROJECT_ID=
FB_PRIVATE_KEY_ID=
FB_PRIVATE_KEY=
FB_CLIENT_EMAIL=
FB_CLIENT_ID=
FB_AUTH_URI=
FB_TOKEN_URI=
FB_AUTH_PROVIDER_X509_CERT_URL=
FB_CLIENT_X509_CERT_URL=
FB_UNIVERSE_DOMAIN=

# Firebase Web API Key
FB_API_KEY=

# Slack
SLACK_CHANNEL_ID=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Cloud Run scheme processor
PROCESSOR_SERVICE_URL=

# Notion content review queue (#407). NOTION_API_TOKEN comes from Secret Manager
# (bettersg/schemessg-infra); don't set it here, or the Functions deploy fails. The data
# source ID picks the review database, so dev and prod each need their own.
# Unset = the hourly push and sweep do nothing.
NOTION_CONTENT_CHECK_DATA_SOURCE_ID=

# Azure OpenAI, Southeast Asia (Functions, and the monthly content check job that
# scheme-processor/deploy.sh deploys from this file). The job takes the key and
# SLACK_BOT_TOKEN from Secret Manager instead; the Functions still read them from here.
AZURE_OPENAI_ENDPOINT_SEA=
AZURE_OPENAI_API_KEY_SEA=
